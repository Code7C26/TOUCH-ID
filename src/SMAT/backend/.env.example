# Copiá este archivo como .env y completá tus datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=robot_db
JWT_SECRET=cambia_esta_clave
FLASK_PORT=5000

# Claves de las máquinas (header X-API-KEY). Generá una distinta para cada una.
YOLO_API_KEY=
ROBOT_API_KEY=

# Notificaciones push (Web Push). Generalas con:  python tools/generar_claves_push.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:tu-mail@ejemplo.com
