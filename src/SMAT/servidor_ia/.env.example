# Copiá este archivo como .env y poné tus IPs (el .env no se sube a GitHub)
# IP que muestra la app IP Webcam (dejale el /video al final)
URL_CAMARA_CELULAR=http://192.168.0.100:8080/video
# IP que muestra la pantalla del robot (dejale /alerta_seguridad al final)
URL_ESP32_ALERTA=http://192.168.0.101/alerta_seguridad

# Conexión con la web. Si la IA corre en la MISMA PC que el backend, dejalas vacías.
# Si corre en otra PC: la IP de la PC del backend (con /api al final) y la clave que te pasa Toro por fuera de GitHub
DROID_URL=
YOLO_API_KEY=
# Opcional: zona fija (si no, la web usa la zona donde está el robot)
DROID_ZONA_ID=
