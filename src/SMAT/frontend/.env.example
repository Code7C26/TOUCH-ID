# Copiá como .env. Si abrís la web desde el celular, poné la IP de tu PC en vez de localhost
VITE_API_URL=http://localhost:5000/api

# Página pública (Contacto). Opcionales: si no se ponen, Contacto lo avisa.
# El mail y el teléfono del proyecto NO se suben al repo: van solo en tu .env
VITE_CONTACTO_EMAIL=
# WhatsApp con código de país, sin + ni espacios (ej. 5491122334455)
VITE_CONTACTO_WHATSAPP=
